NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/studentdesk
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=sd_token
CLIENT_ORIGIN=http://localhost:5173
PAYMENT_PROVIDER=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
UPLOAD_DIR=.data/uploads
MAX_FILE_MB=10
SUPPORT_EMAIL=support@acadexa.example

# File storage (Cloudinary). Fill these in to store uploaded PDFs in the cloud.
# Without them the server falls back to local disk under UPLOAD_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=acadexa/documents

# Optional: override the seeded administrator account
ADMIN_EMAIL=yuglakhani99@gmail.com
ADMIN_PASSWORD= Yug@1213
